APP_ENV=development
DEMO_SEED=true
# SQLite is used for local demo mode. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./rakt_sanket.db
FRONTEND_ORIGIN=http://localhost:5173

# Optional SMTP delivery for donor outreach. Leave SMTP_HOST empty to keep
# campaigns simulated. Use an app password, never your normal mailbox password.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=RaktSanket
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
