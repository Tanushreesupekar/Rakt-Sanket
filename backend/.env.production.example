APP_ENV=production
DEMO_SEED=false
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
SECRET_KEY=replace-with-at-least-32-random-secret-bytes
FRONTEND_ORIGINS=https://app.example.org
ALLOWED_HOSTS=api.example.org
ACCESS_TOKEN_MINUTES=30
ENABLE_API_DOCS=false

# Optional donor outreach email. Leave SMTP_HOST empty to keep campaigns simulated.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=RaktSanket
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
